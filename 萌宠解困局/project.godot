; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="萌宠解困局"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]

default_bus_layout="res://default_bus_layout.tres"

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
select_orange={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
select_doubao={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
select_snow={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
undo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":90), Object(InputEventKey,"physical_keycode":85)]
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[gui]

theme/default_font_multichannel_signed_distance_field=true
